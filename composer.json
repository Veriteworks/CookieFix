{
    "name":"veriteworks/cookiefix",
    "type":"magento2-module",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "description":"Magento2 extension for Cookie SameSite attribute.",
    "version":"3.2.3",
    "authors":[
        {
            "name":"Hirokazu Nishi",
            "email":"nishi@veriteworks.co.jp",
            "homepage":"https://principle-works.jp/",
            "role":"developer"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "~102.0.6-p1||~103.0.1",
        "lib-libxml": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Veriteworks\\CookieFix\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
